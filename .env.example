# Flask Environment
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=exam_proctoring_super_secret_key_change_in_production_2026

# Database
# For SQLite:
DATABASE_URL=sqlite:///instance/exam.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/exam_proctoring

# File Storage
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Proctoring Engine Configurations
PROCTORING_ENABLED=true
FRAME_INTERVAL=2.0
DEMO_MODE=false

# Risk Scoring Thresholds
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MEDIUM=50
RISK_THRESHOLD_HIGH=80
